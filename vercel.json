{
  "buildCommand": "bun install && bun run build",
  "outputDirectory": "dist",
  "framework": "vue",
  "rewrites": [
    {
      "source": "/api/melograph/analyze",
      "destination": "https://melograph-swart.vercel.app/api/analyze"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
